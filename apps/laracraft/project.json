{
  "name": "laracraft",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "lc",
  "sourceRoot": "apps/laracraft/src",
  "tags": ["type:app", "scope:client"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["^build", "textures:credits", "textures:atlas"],
      "inputs": [
        "production",
        "^production",
        {
          "dependentTasksOutputFiles": "**/*.{json,png}"
        }
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/laracraft",
          "browser": ""
        },
        "browser": "apps/laracraft/src/main.ts",
        "tsConfig": "apps/laracraft/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/laracraft/public"
          },
          {
            "glob": "**/*",
            "input": "dist/assets/textures",
            "output": "assets/textures"
          }
        ],
        "styles": ["apps/laracraft/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "laracraft:build:production"
        },
        "development": {
          "buildTarget": "laracraft:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "laracraft:build",
        "staticFilePath": "dist/apps/laracraft",
        "spa": true
      }
    },
    "cap-sync": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "cwd": "apps/laracraft",
        "command": "cap sync"
      }
    },
    "android-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["cap-sync"],
      "cache": false,
      "outputs": ["{projectRoot}/android/app/build/outputs/apk"],
      "options": {
        "cwd": "apps/laracraft/android",
        "command": "./gradlew assembleDebug"
      }
    },
    "ios-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["cap-sync"],
      "cache": false,
      "options": {
        "cwd": "apps/laracraft/ios/App",
        "command": "xcodebuild -project App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build/DerivedData CODE_SIGNING_ALLOWED=NO build"
      }
    }
  }
}
