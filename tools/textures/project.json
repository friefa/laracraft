{
  "name": "textures",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/textures/src",
  "projectType": "application",
  "tags": ["type:tool", "scope:shared"],
  "targets": {
    "validate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/assets/textures/**/*",
        "{workspaceRoot}/assets/LICENSES.md",
        "{projectRoot}/src/**/*.ts"
      ],
      "options": {
        "command": "tsx tools/textures/src/cli.ts validate"
      }
    },
    "atlas": {
      "executor": "nx:run-commands",
      "dependsOn": ["validate"],
      "cache": false,
      "inputs": [
        "{workspaceRoot}/assets/textures/**/*",
        "{projectRoot}/src/**/*.ts",
        {
          "env": "LARACRAFT_LOCAL_TEXTURES"
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/assets/textures/atlas.png",
        "{workspaceRoot}/dist/assets/textures/atlas.json"
      ],
      "options": {
        "command": "tsx tools/textures/src/cli.ts atlas"
      },
      "configurations": {
        "local-textures": {
          "command": "tsx tools/textures/src/cli.ts atlas --local"
        }
      }
    },
    "guard-no-local": {
      "executor": "nx:run-commands",
      "dependsOn": ["atlas", "credits"],
      "cache": false,
      "options": {
        "command": "tsx tools/textures/src/cli.ts guard --strict --dir dist/assets/textures"
      },
      "configurations": {
        "local-textures": {
          "command": "tsx tools/textures/src/cli.ts guard --dir dist/assets/textures"
        }
      }
    },
    "credits": {
      "executor": "nx:run-commands",
      "inputs": ["{workspaceRoot}/assets/textures/**/*", "{projectRoot}/src/**/*.ts"],
      "outputs": [
        "{workspaceRoot}/dist/assets/textures/credits.json",
        "{workspaceRoot}/assets/LICENSES.md"
      ],
      "options": {
        "command": "tsx tools/textures/src/cli.ts credits"
      }
    },
    "placeholders": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx tools/textures/src/cli.ts placeholders"
      }
    },
    "own-textures": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx tools/textures/src/cli.ts own-textures"
      }
    },
    "import-ppl": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig tools/textures/tsconfig.lib.json tools/textures/src/import/import-ppl.ts"
      }
    },
    "import-local": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx --tsconfig tools/textures/tsconfig.lib.json tools/textures/src/local/import-local.ts"
      }
    }
  }
}
