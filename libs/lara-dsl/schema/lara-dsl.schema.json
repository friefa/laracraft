{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laracraft.app/schema/lara-dsl.schema.json",
  "title": "Lara build operation",
  "description": "One Lara DSL operation (see libs/lara-dsl/src/lib/types.ts). Tool call arguments of tool <name> validate against $defs/<Op>ToolInput (see lara-tools.json for the name mapping). Generated by `nx run lara-dsl:schema`; do not edit.",
  "oneOf": [
    { "$ref": "#/$defs/FillOp" },
    { "$ref": "#/$defs/HollowBoxOp" },
    { "$ref": "#/$defs/LineOp" },
    { "$ref": "#/$defs/WallOp" },
    { "$ref": "#/$defs/FloorOp" },
    { "$ref": "#/$defs/RoofOp" },
    { "$ref": "#/$defs/PlaceBlockOp" },
    { "$ref": "#/$defs/ReplaceOp" },
    { "$ref": "#/$defs/ClearOp" },
    { "$ref": "#/$defs/MirrorOp" },
    { "$ref": "#/$defs/RotateOp" },
    { "$ref": "#/$defs/CopyOp" },
    { "$ref": "#/$defs/InsertModuleOp" }
  ],
  "$defs": {
    "Coordinate": { "type": "integer", "minimum": -4096, "maximum": 4096 },
    "Pos": {
      "type": "object",
      "description": "Block position, integers in [-4096, 4096]. Y is up; north = -Z, south = +Z, east = +X, west = -X.",
      "properties": {
        "x": { "$ref": "#/$defs/Coordinate" },
        "y": { "$ref": "#/$defs/Coordinate" },
        "z": { "$ref": "#/$defs/Coordinate" }
      },
      "required": ["x", "y", "z"],
      "additionalProperties": false
    },
    "Offset": {
      "type": "object",
      "description": "Integer offset (x, y, z), each in [-4096, 4096].",
      "properties": {
        "x": { "$ref": "#/$defs/Coordinate" },
        "y": { "$ref": "#/$defs/Coordinate" },
        "z": { "$ref": "#/$defs/Coordinate" }
      },
      "required": ["x", "y", "z"],
      "additionalProperties": false
    },
    "Region": {
      "type": "object",
      "description": "Inclusive box between two corner cells (any order).",
      "properties": { "from": { "$ref": "#/$defs/Pos" }, "to": { "$ref": "#/$defs/Pos" } },
      "required": ["from", "to"],
      "additionalProperties": false
    },
    "Block": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:[a-z0-9_.-]+:)?[a-z0-9_./-]+(?:\\[[a-z0-9_=, ]*\\])?$",
      "description": "Java Edition blockstate, e.g. \"minecraft:stone_bricks\" or \"minecraft:oak_stairs[facing=east,half=top]\". Namespace optional; omitted properties take their defaults."
    },
    "BlockList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/Block" }
    },
    "HorizontalFacing": { "type": "string", "enum": ["north", "east", "south", "west"] },
    "FillOp": {
      "type": "object",
      "properties": {
        "op": { "const": "fill" },
        "region": { "$ref": "#/$defs/Region" },
        "block": { "$ref": "#/$defs/Block" },
        "onlyReplace": {
          "$ref": "#/$defs/BlockList",
          "description": "Mask: only cells currently holding one of these blocks are changed (patterns as in `replace.from`, `minecraft:air` allowed). Omit to change every cell."
        }
      },
      "required": ["op", "region", "block"],
      "additionalProperties": false
    },
    "HollowBoxOp": {
      "type": "object",
      "properties": {
        "op": { "const": "hollowBox" },
        "region": { "$ref": "#/$defs/Region" },
        "block": { "$ref": "#/$defs/Block" },
        "keepInterior": {
          "type": "boolean",
          "description": "true: leave the interior untouched. Default false: interior becomes air."
        },
        "onlyReplace": {
          "$ref": "#/$defs/BlockList",
          "description": "Mask: only cells currently holding one of these blocks are changed (patterns as in `replace.from`, `minecraft:air` allowed). Omit to change every cell."
        }
      },
      "required": ["op", "region", "block"],
      "additionalProperties": false
    },
    "LineOp": {
      "type": "object",
      "properties": {
        "op": { "const": "line" },
        "from": { "$ref": "#/$defs/Pos", "description": "Start cell (inclusive)." },
        "to": { "$ref": "#/$defs/Pos", "description": "End cell (inclusive)." },
        "block": { "$ref": "#/$defs/Block" },
        "onlyReplace": {
          "$ref": "#/$defs/BlockList",
          "description": "Mask: only cells currently holding one of these blocks are changed (patterns as in `replace.from`, `minecraft:air` allowed). Omit to change every cell."
        }
      },
      "required": ["op", "from", "to", "block"],
      "additionalProperties": false
    },
    "WallOp": {
      "type": "object",
      "properties": {
        "op": { "const": "wall" },
        "from": {
          "$ref": "#/$defs/Pos",
          "description": "Start of the wall base line; its y is the bottom layer."
        },
        "to": {
          "$ref": "#/$defs/Pos",
          "description": "End of the wall base line; y must equal from.y."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of layers, counted upwards from from.y (>= 1)."
        },
        "block": { "$ref": "#/$defs/Block" },
        "onlyReplace": {
          "$ref": "#/$defs/BlockList",
          "description": "Mask: only cells currently holding one of these blocks are changed (patterns as in `replace.from`, `minecraft:air` allowed). Omit to change every cell."
        }
      },
      "required": ["op", "from", "to", "height", "block"],
      "additionalProperties": false
    },
    "FloorOp": {
      "type": "object",
      "properties": {
        "op": { "const": "floor" },
        "region": {
          "$ref": "#/$defs/Region",
          "description": "Only the X/Z footprint is used; its Y is ignored."
        },
        "y": { "$ref": "#/$defs/Coordinate", "description": "Height of the single layer." },
        "block": { "$ref": "#/$defs/Block" },
        "onlyReplace": {
          "$ref": "#/$defs/BlockList",
          "description": "Mask: only cells currently holding one of these blocks are changed (patterns as in `replace.from`, `minecraft:air` allowed). Omit to change every cell."
        }
      },
      "required": ["op", "region", "y", "block"],
      "additionalProperties": false
    },
    "RoofOp": {
      "type": "object",
      "properties": {
        "op": { "const": "roof" },
        "region": {
          "$ref": "#/$defs/Region",
          "description": "The building below the roof: the roof covers its X/Z footprint and starts at max Y + 1."
        },
        "type": { "type": "string", "enum": ["gable", "hip", "shed", "flat"] },
        "pitch": {
          "type": "integer",
          "enum": [1, 2],
          "description": "1 = 45° (stairs only), 2 = steep (full block under each stair)."
        },
        "stairs": {
          "$ref": "#/$defs/Block",
          "description": "A stairs block for the slopes (orientation is computed)."
        },
        "block": {
          "$ref": "#/$defs/Block",
          "description": "Full block for ridge, gable ends and flat roofs."
        },
        "ridgeAxis": {
          "type": "string",
          "enum": ["x", "z"],
          "description": "gable/shed: axis the ridge (shed: high edge) runs along. Default: the longer side."
        },
        "overhang": {
          "type": "integer",
          "enum": [0, 1, 2],
          "description": "Eaves beyond the footprint on every side (default 0)."
        }
      },
      "required": ["op", "region", "type", "pitch", "stairs", "block"],
      "additionalProperties": false
    },
    "PlaceBlockOp": {
      "type": "object",
      "properties": {
        "op": { "const": "placeBlock" },
        "pos": { "$ref": "#/$defs/Pos" },
        "block": { "$ref": "#/$defs/Block" }
      },
      "required": ["op", "pos", "block"],
      "additionalProperties": false
    },
    "ReplaceOp": {
      "type": "object",
      "properties": {
        "op": { "const": "replace" },
        "region": { "$ref": "#/$defs/Region" },
        "from": {
          "$ref": "#/$defs/Block",
          "description": "Pattern: a bare id matches every state of that block; listed properties must match."
        },
        "to": {
          "$ref": "#/$defs/Block",
          "description": "Replacement. Properties not written here are kept from the replaced block when valid."
        }
      },
      "required": ["op", "region", "from", "to"],
      "additionalProperties": false
    },
    "ClearOp": {
      "type": "object",
      "properties": { "op": { "const": "clear" }, "region": { "$ref": "#/$defs/Region" } },
      "required": ["op", "region"],
      "additionalProperties": false
    },
    "MirrorOp": {
      "type": "object",
      "properties": {
        "op": { "const": "mirror" },
        "region": { "$ref": "#/$defs/Region" },
        "axis": {
          "type": "string",
          "enum": ["x", "z"],
          "description": "x: flip east/west (X coordinates). z: flip north/south (Z coordinates)."
        }
      },
      "required": ["op", "region", "axis"],
      "additionalProperties": false
    },
    "RotateOp": {
      "type": "object",
      "properties": {
        "op": { "const": "rotate" },
        "region": { "$ref": "#/$defs/Region" },
        "turns": {
          "type": "integer",
          "enum": [1, 2, 3],
          "description": "Clockwise quarter turns seen from above (1 = 90°, 2 = 180°, 3 = 270°)."
        }
      },
      "required": ["op", "region", "turns"],
      "additionalProperties": false
    },
    "CopyOp": {
      "type": "object",
      "properties": {
        "op": { "const": "copy" },
        "region": { "$ref": "#/$defs/Region", "description": "Source box." },
        "to": {
          "$ref": "#/$defs/Pos",
          "description": "Destination of the source's minimum corner (first copy)."
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "description": "Number of copies (default 1)."
        },
        "step": {
          "$ref": "#/$defs/Offset",
          "description": "Offset between consecutive copies. Default: {x: source size along X, y: 0, z: 0}."
        }
      },
      "required": ["op", "region", "to"],
      "additionalProperties": false
    },
    "InsertModuleOp": {
      "type": "object",
      "properties": {
        "op": { "const": "insertModule" },
        "moduleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9_.:/-]+$",
          "description": "Id of a module from the module catalogue."
        },
        "pos": {
          "$ref": "#/$defs/Pos",
          "description": "Position of the module's documented anchor."
        },
        "facing": {
          "$ref": "#/$defs/HorizontalFacing",
          "description": "Direction the module faces."
        },
        "params": {
          "type": "object",
          "description": "Module-specific parameters (checked by the module).",
          "maxProperties": 32,
          "propertyNames": { "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
          "additionalProperties": {
            "anyOf": [
              { "type": "string", "maxLength": 256 },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        }
      },
      "required": ["op", "moduleId", "pos", "facing"],
      "additionalProperties": false
    },
    "FillToolInput": {
      "type": "object",
      "properties": {
        "region": { "$ref": "#/$defs/Region" },
        "block": { "$ref": "#/$defs/Block" },
        "onlyReplace": {
          "$ref": "#/$defs/BlockList",
          "description": "Mask: only cells currently holding one of these blocks are changed (patterns as in `replace.from`, `minecraft:air` allowed). Omit to change every cell."
        }
      },
      "required": ["region", "block"],
      "additionalProperties": false
    },
    "HollowBoxToolInput": {
      "type": "object",
      "properties": {
        "region": { "$ref": "#/$defs/Region" },
        "block": { "$ref": "#/$defs/Block" },
        "keepInterior": {
          "type": "boolean",
          "description": "true: leave the interior untouched. Default false: interior becomes air."
        },
        "onlyReplace": {
          "$ref": "#/$defs/BlockList",
          "description": "Mask: only cells currently holding one of these blocks are changed (patterns as in `replace.from`, `minecraft:air` allowed). Omit to change every cell."
        }
      },
      "required": ["region", "block"],
      "additionalProperties": false
    },
    "LineToolInput": {
      "type": "object",
      "properties": {
        "from": { "$ref": "#/$defs/Pos", "description": "Start cell (inclusive)." },
        "to": { "$ref": "#/$defs/Pos", "description": "End cell (inclusive)." },
        "block": { "$ref": "#/$defs/Block" },
        "onlyReplace": {
          "$ref": "#/$defs/BlockList",
          "description": "Mask: only cells currently holding one of these blocks are changed (patterns as in `replace.from`, `minecraft:air` allowed). Omit to change every cell."
        }
      },
      "required": ["from", "to", "block"],
      "additionalProperties": false
    },
    "WallToolInput": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/Pos",
          "description": "Start of the wall base line; its y is the bottom layer."
        },
        "to": {
          "$ref": "#/$defs/Pos",
          "description": "End of the wall base line; y must equal from.y."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of layers, counted upwards from from.y (>= 1)."
        },
        "block": { "$ref": "#/$defs/Block" },
        "onlyReplace": {
          "$ref": "#/$defs/BlockList",
          "description": "Mask: only cells currently holding one of these blocks are changed (patterns as in `replace.from`, `minecraft:air` allowed). Omit to change every cell."
        }
      },
      "required": ["from", "to", "height", "block"],
      "additionalProperties": false
    },
    "FloorToolInput": {
      "type": "object",
      "properties": {
        "region": {
          "$ref": "#/$defs/Region",
          "description": "Only the X/Z footprint is used; its Y is ignored."
        },
        "y": { "$ref": "#/$defs/Coordinate", "description": "Height of the single layer." },
        "block": { "$ref": "#/$defs/Block" },
        "onlyReplace": {
          "$ref": "#/$defs/BlockList",
          "description": "Mask: only cells currently holding one of these blocks are changed (patterns as in `replace.from`, `minecraft:air` allowed). Omit to change every cell."
        }
      },
      "required": ["region", "y", "block"],
      "additionalProperties": false
    },
    "RoofToolInput": {
      "type": "object",
      "properties": {
        "region": {
          "$ref": "#/$defs/Region",
          "description": "The building below the roof: the roof covers its X/Z footprint and starts at max Y + 1."
        },
        "type": { "type": "string", "enum": ["gable", "hip", "shed", "flat"] },
        "pitch": {
          "type": "integer",
          "enum": [1, 2],
          "description": "1 = 45° (stairs only), 2 = steep (full block under each stair)."
        },
        "stairs": {
          "$ref": "#/$defs/Block",
          "description": "A stairs block for the slopes (orientation is computed)."
        },
        "block": {
          "$ref": "#/$defs/Block",
          "description": "Full block for ridge, gable ends and flat roofs."
        },
        "ridgeAxis": {
          "type": "string",
          "enum": ["x", "z"],
          "description": "gable/shed: axis the ridge (shed: high edge) runs along. Default: the longer side."
        },
        "overhang": {
          "type": "integer",
          "enum": [0, 1, 2],
          "description": "Eaves beyond the footprint on every side (default 0)."
        }
      },
      "required": ["region", "type", "pitch", "stairs", "block"],
      "additionalProperties": false
    },
    "PlaceBlockToolInput": {
      "type": "object",
      "properties": { "pos": { "$ref": "#/$defs/Pos" }, "block": { "$ref": "#/$defs/Block" } },
      "required": ["pos", "block"],
      "additionalProperties": false
    },
    "ReplaceToolInput": {
      "type": "object",
      "properties": {
        "region": { "$ref": "#/$defs/Region" },
        "from": {
          "$ref": "#/$defs/Block",
          "description": "Pattern: a bare id matches every state of that block; listed properties must match."
        },
        "to": {
          "$ref": "#/$defs/Block",
          "description": "Replacement. Properties not written here are kept from the replaced block when valid."
        }
      },
      "required": ["region", "from", "to"],
      "additionalProperties": false
    },
    "ClearToolInput": {
      "type": "object",
      "properties": { "region": { "$ref": "#/$defs/Region" } },
      "required": ["region"],
      "additionalProperties": false
    },
    "MirrorToolInput": {
      "type": "object",
      "properties": {
        "region": { "$ref": "#/$defs/Region" },
        "axis": {
          "type": "string",
          "enum": ["x", "z"],
          "description": "x: flip east/west (X coordinates). z: flip north/south (Z coordinates)."
        }
      },
      "required": ["region", "axis"],
      "additionalProperties": false
    },
    "RotateToolInput": {
      "type": "object",
      "properties": {
        "region": { "$ref": "#/$defs/Region" },
        "turns": {
          "type": "integer",
          "enum": [1, 2, 3],
          "description": "Clockwise quarter turns seen from above (1 = 90°, 2 = 180°, 3 = 270°)."
        }
      },
      "required": ["region", "turns"],
      "additionalProperties": false
    },
    "CopyToolInput": {
      "type": "object",
      "properties": {
        "region": { "$ref": "#/$defs/Region", "description": "Source box." },
        "to": {
          "$ref": "#/$defs/Pos",
          "description": "Destination of the source's minimum corner (first copy)."
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "description": "Number of copies (default 1)."
        },
        "step": {
          "$ref": "#/$defs/Offset",
          "description": "Offset between consecutive copies. Default: {x: source size along X, y: 0, z: 0}."
        }
      },
      "required": ["region", "to"],
      "additionalProperties": false
    },
    "InsertModuleToolInput": {
      "type": "object",
      "properties": {
        "moduleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9_.:/-]+$",
          "description": "Id of a module from the module catalogue."
        },
        "pos": {
          "$ref": "#/$defs/Pos",
          "description": "Position of the module's documented anchor."
        },
        "facing": {
          "$ref": "#/$defs/HorizontalFacing",
          "description": "Direction the module faces."
        },
        "params": {
          "type": "array",
          "description": "Module-specific parameters as name/value pairs (names must be unique).",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "value": {
                "anyOf": [
                  { "type": "string", "maxLength": 256 },
                  { "type": "number" },
                  { "type": "boolean" }
                ]
              }
            },
            "required": ["name", "value"],
            "additionalProperties": false
          }
        }
      },
      "required": ["moduleId", "pos", "facing"],
      "additionalProperties": false
    }
  }
}
